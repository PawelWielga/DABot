{
  "$schema": "../schemas/scenario.schema.json",
  "name": "variable-interpolation",
  "steps": [
    {
      "type": "OpenUrl",
      "url": "data:text/html,<main><span id='value'>interpolated</span></main>"
    },
    {
      "type": "ReadText",
      "selector": "#value",
      "output": "message"
    },
    {
      "type": "OpenUrl",
      "url": "data:text/html,<main><h1 id='result'>{{message}}</h1><small id='run'>{{runId}}</small></main>"
    },
    {
      "type": "ReadText",
      "selector": "#result",
      "output": "result"
    }
  ]
}
