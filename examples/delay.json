{
  "$schema": "../schemas/scenario.schema.json",
  "name": "Fixed delay",
  "steps": [
    {
      "type": "OpenUrl",
      "url": "data:text/html,<main><h1 id='status'>Ready</h1></main>"
    },
    {
      "type": "Delay",
      "timeoutMs": 100
    },
    {
      "type": "ReadText",
      "selector": "#status",
      "output": "status"
    }
  ]
}
