{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PawelWielga/DABot/main/schemas/scenario.schema.json",
  "title": "DABot scenario",
  "description": "Machine-readable contract for DABot JSON scenario files. Step types may exist in the domain model before they have an executable handler; see each type description and README project status. String-valued step fields support {{variableName}} interpolation at execution time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional editor/tooling reference to this schema."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable scenario name."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional maximum duration for the whole scenario in milliseconds. When exceeded, execution stops and the run result reports a timeout failure."
    },
    "browserProfile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Optional named persistent browser profile. When omitted, the run uses an isolated ephemeral session."
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "description": "Scenario step type.",
          "oneOf": [
            {
              "const": "OpenUrl",
              "description": "Available: navigate to a URL and wait for the normal page load event. Use an explicit WaitFor step for stronger synchronization such as selector/text/URL/load-state conditions."
            },
            {
              "const": "Click",
              "description": "Available: click an element selected by selector."
            },
            {
              "const": "FillText",
              "description": "Available: fill an element with text."
            },
            {
              "const": "PasteText",
              "description": "Available: focus an element and insert text through the keyboard path."
            },
            {
              "const": "ReadText",
              "description": "Available: read element text into a named output."
            },
            {
              "const": "WaitFor",
              "description": "Available: wait for selector, text, URL or load state."
            },
            {
              "const": "Screenshot",
              "description": "Available: capture a full-page screenshot artifact."
            },
            {
              "const": "CallApi",
              "description": "Available: call an HTTP endpoint with GET, POST or PUT. Configure method, responsePath and bearerTokenEnv in parameters."
            },
            {
              "const": "Delay",
              "description": "Available: pause execution for a fixed number of milliseconds."
            },
            {
              "const": "If",
              "description": "Available: execute children when value resolves to true. Value accepts true/false or an exact variable reference."
            },
            {
              "const": "Loop",
              "description": "Available: execute children a fixed number of times. Value accepts a non-negative integer or an exact variable reference."
            },
            {
              "const": "Suspend",
              "description": "Available in durable execution: persist the next execution cursor and return Suspended. Optional parameters.reason is Human (default), Event, or Schedule."
            }
          ]
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Optional execution switch. Omitted or true means the step executes normally. false skips the step; for If and Loop it skips the entire nested subtree."
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "description": "Legacy Playwright selector for element-oriented steps. Preserved for compatibility; new scenarios may use locator instead. Supports {{variableName}} interpolation."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "URL used by OpenUrl or CallApi, or optionally by WaitFor URL mode. Supports {{variableName}} interpolation."
        },
        "value": {
          "type": "string",
          "description": "Text/value consumed by a step. Supports {{variableName}} interpolation; Delay accepts milliseconds, If accepts true/false, and Loop accepts a non-negative iteration count."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Output variable name used by ReadText or CallApi. Outputs can be referenced by later steps as {{name}}."
        },
        "timeoutMs": {
          "type": "integer",
          "description": "Optional step-specific timeout in milliseconds. For Delay this is the delay duration; CallApi requires a positive value when specified."
        },
        "retryCount": {
          "type": "integer",
          "description": "Number of additional attempts after the initial execution. Applied by both synchronous and durable execution."
        },
        "parameters": {
          "type": "object",
          "description": "Generic step parameters. String-valued parameters support {{variableName}} interpolation; an exact variable reference preserves the runtime JSON type. WaitFor recognizes mode; CallApi recognizes method, responsePath, bearerTokenSecret and legacy bearerTokenEnv.",
          "properties": {
            "mode": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "selector",
                    "url",
                    "loadstate",
                    "text"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^\\{\\{\\s*[A-Za-z0-9_.-]+\\s*\\}\\}$"
                }
              ],
              "description": "WaitFor mode or a variable reference resolving to one of the supported modes."
            },
            "bearerTokenSecret": {
              "type": "string",
              "minLength": 1,
              "description": "Secret name resolved at execution time through ISecretProvider. The secret value is never stored as a normal run variable."
            },
            "bearerTokenEnv": {
              "type": "string",
              "minLength": 1,
              "description": "Backward-compatible environment-variable secret reference. Prefer bearerTokenSecret for provider-neutral scenarios."
            }
          },
          "additionalProperties": true
        },
        "children": {
          "type": "array",
          "description": "Nested steps executed by If and Loop control-flow steps.",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Selector",
                "Text",
                "TestId"
              ],
              "default": "Selector",
              "description": "Locator strategy. Selector uses Playwright selector syntax; Text uses getByText; TestId uses getByTestId."
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "description": "Locator value. Supports {{variableName}} interpolation."
            },
            "exact": {
              "type": "boolean",
              "default": false,
              "description": "For Text locators, require an exact text match."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "OpenUrl",
                  "CallApi"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "Click",
                  "FillText",
                  "PasteText",
                  "ReadText"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "selector"
                ]
              },
              {
                "required": [
                  "locator"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ReadText"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "output"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "WaitFor"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "selector"
                ]
              },
              {
                "required": [
                  "locator"
                ]
              },
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "parameters"
                ],
                "properties": {
                  "parameters": {
                    "minProperties": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Delay"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "timeoutMs"
                ],
                "properties": {
                  "timeoutMs": {
                    "minimum": 0
                  }
                }
              },
              {
                "not": {
                  "required": [
                    "timeoutMs"
                  ]
                },
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "pattern": "^(?:[0-9]+|\\{\\{\\s*[A-Za-z0-9_.-]+\\s*\\}\\})$"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "If",
                  "Loop"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "children"
            ],
            "properties": {
              "children": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "WaitFor"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "selector"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "type",
              "parameters"
            ]
          },
          "then": {
            "required": [
              "selector"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "WaitFor"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "url"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "type",
              "parameters"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "locator"
                ]
              },
              {
                "required": [
                  "url"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "WaitFor"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "mode": {
                    "enum": [
                      "loadstate",
                      "text"
                    ]
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "type",
              "parameters"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "CallApi"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "timeoutMs": {
                "minimum": 1
              },
              "parameters": {
                "properties": {
                  "method": {
                    "enum": [
                      "GET",
                      "POST",
                      "PUT"
                    ]
                  },
                  "responsePath": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bearerTokenEnv": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "If",
                  "Loop"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "value",
              "children"
            ],
            "properties": {
              "children": {
                "minItems": 1
              }
            }
          }
        },
        {
          "not": {
            "required": [
              "selector",
              "locator"
            ]
          },
          "description": "A step must not define both legacy selector and locator."
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Suspend"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "children": {
                "maxItems": 0
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": [
                      "Human",
                      "Event",
                      "Schedule"
                    ],
                    "default": "Human"
                  },
                  "correlationId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Required when reason is Event. Identifies the waiting run for external event delivery."
                  },
                  "eventType": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Optional event type filter for an Event suspension."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Suspend"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "reason": {
                    "const": "Event"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            },
            "required": [
              "type",
              "parameters"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "required": [
                  "correlationId"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
