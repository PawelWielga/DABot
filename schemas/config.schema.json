{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PawelWielga/DABot/main/schemas/config.schema.json",
  "title": "DABot configuration",
  "description": "Machine-readable contract for the repository-root DABot config.json file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bot"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional editor/tooling reference to this schema."
    },
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenarioPath": {
          "type": "string",
          "minLength": 1,
          "description": "Scenario file to load. Relative paths are resolved by the runner/loader."
        },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identityPath": {
              "type": "string",
              "minLength": 1,
              "default": "data/node-id",
              "description": "Machine-local file that stores the stable DABot NodeId. Persist this path across process restarts and do not share it between distinct nodes."
            },
            "displayName": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "Optional human-friendly node name. When omitted, DABot uses the machine name."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "default": [],
              "description": "Operator-defined labels used to describe the node, for example region:home-lab."
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "default": [],
              "description": "Additional operator-defined execution capabilities. Runtime-detected OS/browser capabilities are added automatically."
            },
            "executionSlots": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "Configured execution capacity reported by this node. Scheduler enforcement is added in a later Sprint 10 step."
            },
            "heartbeatIntervalSeconds": {
              "type": "integer",
              "minimum": 1,
              "default": 15,
              "description": "Interval between persisted node heartbeats for long-running workers and the web runtime."
            }
          }
        },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headless": {
              "type": "boolean",
              "default": true
            },
            "slowMoMs": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 0,
              "default": 30000
            },
            "viewportWidth": {
              "type": "integer",
              "minimum": 1,
              "default": 1280
            },
            "viewportHeight": {
              "type": "integer",
              "minimum": 1,
              "default": 720
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scenariosDirectory": {
              "type": "string",
              "minLength": 1,
              "default": "scenarios"
            },
            "screenshotsDirectory": {
              "type": "string",
              "minLength": 1,
              "default": "screenshots"
            },
            "artifactsDirectory": {
              "type": "string",
              "minLength": 1,
              "default": "artifacts"
            },
            "databasePath": {
              "type": "string",
              "minLength": 1,
              "default": "data/dabot.db"
            },
            "browserProfilesDirectory": {
              "type": "string",
              "minLength": 1,
              "default": "data/browser-profiles",
              "description": "Runtime directory for persistent browser profile data; keep it outside version control."
            }
          }
        },
        "retryWorker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pollIntervalMs": {
              "type": "integer",
              "minimum": 1,
              "default": 1000
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            }
          }
        },
        "eventWorker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pollIntervalMs": {
              "type": "integer",
              "minimum": 1,
              "default": 1000
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "default": 5
            },
            "baseRetryDelayMs": {
              "type": "integer",
              "minimum": 0,
              "default": 1000
            },
            "maxRetryDelayMs": {
              "type": "integer",
              "minimum": 0,
              "default": 60000
            }
          }
        },
        "interactiveBrowser": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxDurationSeconds": {
              "type": "integer",
              "minimum": 1,
              "default": 1800,
              "description": "Maximum lifetime of one headed interactive browser-profile session before DABot closes it automatically."
            }
          }
        },
        "observerWorker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pollIntervalMs": {
              "type": "integer",
              "minimum": 1,
              "default": 1000
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1,
              "default": 50
            },
            "maxErrorBackoffMs": {
              "type": "integer",
              "minimum": 1,
              "default": 60000
            }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "default": "logs/dabot.jsonl"
            }
          }
        },
        "sensitiveValues": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "environmentVariables": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "default": [],
              "description": "Environment variable names whose current values are replaced with *** in file log messages, exceptions, and structured string properties."
            }
          }
        }
      }
    }
  }
}
