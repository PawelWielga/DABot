@page "/scenarios/new"
@page "/scenarios/{FileName}"
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject IScenarioManagementService ScenarioManagement
@inject IScenarioTestRunService ScenarioTestRun
@inject ManagementUiEnvironment UiEnvironment
@inject NavigationManager Navigation

<PageTitle>@(_isNew ? "New DABot scenario" : $"Edit {FileName}")</PageTitle>

<div class="page-heading">
    <div>
        <h1>@(_isNew ? "New scenario" : "Edit scenario")</h1>
        <p class="lead">@(_isNew ? "Create a scenario JSON file." : $"Editing {FileName}")</p>
    </div>
    <a class="button secondary" href="scenarios">Back to scenarios</a>
</div>

<section class="panel">
    <div class="form-grid">
        <label>
            <span>File name</span>
            <input @bind="_fileName" disabled="@(!_isNew)" placeholder="my-scenario.json" />
        </label>
    </div>

    <div class="scenario-visual-editor">
        <div class="scenario-editor-section-heading">
            <div>
                <h2>Visual editor</h2>
                <p>Edit scenario metadata and steps. Changes are written back to the JSON below.</p>
            </div>

            <button class="button secondary"
                    type="button"
                    @onclick="AddVisualStepAsync"
                    disabled="@(IsBusy || _visualModel is null)">
                Add step
            </button>
        </div>

        @if (_visualModel is null)
        {
            <div class="scenario-errors">
                <div>@(_visualMessage ?? "Fix the JSON validation errors to use the visual editor.")</div>
            </div>
        }
        else
        {
            <div class="scenario-root-grid">
                <label>
                    <span>Name</span>
                    <input @bind="_visualModel.Name"
                           @bind:after="VisualChangedAsync" />
                </label>

                <label>
                    <span>Browser profile</span>
                    <input @bind="_visualModel.BrowserProfile"
                           @bind:after="VisualChangedAsync"
                           placeholder="Optional persistent profile" />
                </label>

                <label>
                    <span>Scenario timeout (ms)</span>
                    <input type="number"
                           @bind="_visualModel.TimeoutMs"
                           @bind:after="VisualChangedAsync"
                           min="1"
                           placeholder="Default" />
                </label>
            </div>

            <div class="scenario-step-list">
                @if (_visualModel.Steps.Count == 0)
                {
                    <p class="muted">No steps yet. Add the first step to continue.</p>
                }
                else
                {
                    @for (var stepIndex = 0; stepIndex < _visualModel.Steps.Count; stepIndex++)
                    {
                        var step = _visualModel.Steps[stepIndex];

                        <ScenarioVisualStepEditor @key="step"
                                                  Model="step"
                                                  Index="stepIndex"
                                                  CanMoveUp="@(stepIndex > 0)"
                                                  CanMoveDown="@(stepIndex < _visualModel.Steps.Count - 1)"
                                                  OnChanged="VisualChangedAsync"
                                                  OnMoveUp="@(() => MoveVisualStepAsync(step, -1))"
                                                  OnMoveDown="@(() => MoveVisualStepAsync(step, 1))"
                                                  OnRemove="@(() => RemoveVisualStepAsync(step))" />
                    }
                }
            </div>
        }
    </div>

    <div class="scenario-json-section">
        <div class="scenario-editor-section-heading compact-heading">
            <div>
                <h2>Scenario JSON</h2>
                <p>Advanced/raw representation. Leaving this field refreshes the visual editor when the JSON is valid.</p>
            </div>
        </div>

        <textarea id="scenario-json"
                  class="json-editor"
                  @bind="_json"
                  @bind:after="JsonChangedAsync"
                  spellcheck="false"></textarea>
    </div>

    @if (_validationErrors.Count > 0)
    {
        <div class="scenario-errors editor-errors">
            @foreach (var error in _validationErrors)
            {
                <div>@error</div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="editor-message">@_message</p>
    }

    <div class="button-row">
        <label class="button secondary file-button">
            Import JSON
            <InputFile OnChange="ImportAsync"
                       accept=".json,application/json"
                       disabled="@IsBusy" />
        </label>
        <a class="button secondary"
           href="@ExportHref"
           download="@ExportFileName">Export JSON</a>
        <button class="button secondary" @onclick="ValidateAsync" disabled="@IsBusy">Validate</button>
        <button class="button secondary"
                @onclick="RunTestAsync"
                disabled="@(UiEnvironment.IsDemo || IsBusy)">
            @(_testRunBusy ? "Running…" : "Test run")
        </button>
        @if (_testRunBusy)
        {
            <button class="button secondary" @onclick="CancelTestRun">Cancel test</button>
        }
        <button class="button primary" @onclick="SaveAsync" disabled="@IsBusy">Save</button>

        @if (!_isNew)
        {
            @if (_confirmDelete)
            {
                <button class="button danger" @onclick="DeleteAsync" disabled="@IsBusy">Confirm delete</button>
                <button class="button secondary" @onclick="CancelDelete" disabled="@IsBusy">Cancel</button>
            }
            else
            {
                <button class="button danger" @onclick="RequestDelete" disabled="@IsBusy">Delete</button>
            }
        }
    </div>
</section>

@if (UiEnvironment.IsDemo)
{
    <p class="muted action-note">Scenario test runs are disabled in the static demo.</p>
}

@if (_testRunResult is not null)
{
    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Test run result</h2>
                <p>Executed directly from the current editor buffer without saving the scenario.</p>
            </div>
            <span class="status @(_testRunResult.Success ? "completed" : "failed")">
                @(_testRunResult.Success ? "Completed" : "Failed")
            </span>
        </div>

        <div class="detail-grid">
            <div class="detail-card">
                <span>Scenario</span>
                <strong>@_testRunResult.ScenarioName</strong>
            </div>
            <div class="detail-card">
                <span>Run ID</span>
                <strong><code>@(_testRunResult.RunId ?? "-")</code></strong>
            </div>
            <div class="detail-card">
                <span>Steps</span>
                <strong>@_testRunResult.Steps.Count</strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_testRunResult.ErrorMessage))
        {
            <div class="scenario-errors editor-errors">
                <div>@_testRunResult.ErrorMessage</div>
            </div>
        }

        @if (_testRunResult.Steps.Count > 0)
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Output</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var step in _testRunResult.Steps)
                        {
                            <tr>
                                <td>@(step.Index + 1)</td>
                                <td>@step.Type</td>
                                <td>
                                    <span class="status @(step.Success ? "completed" : "failed")">
                                        @(step.Success ? "OK" : "Failed")
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(step.OutputName))
                                    {
                                        <code>@step.OutputName</code>
                                        <span> = @step.OutputValue</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(step.ErrorMessage))
                                    {
                                        <span>@step.ErrorMessage</span>
                                    }
                                    else
                                    {
                                        <span class="muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public string? FileName { get; set; }

    private const long MaxImportBytes = 1024 * 1024;

    private bool _isNew;
    private bool _busy;
    private bool _testRunBusy;
    private bool _confirmDelete;
    private CancellationTokenSource? _testRunCancellation;
    private string _fileName = string.Empty;
    private string _json =
        "{\n" +
        "  \"schemaVersion\": 1,\n" +
        "  \"name\": \"New scenario\",\n" +
        "  \"steps\": [\n" +
        "    {\n" +
        "      \"id\": \"open\",\n" +
        "      \"type\": \"OpenUrl\",\n" +
        "      \"url\": \"https://example.com\"\n" +
        "    }\n" +
        "  ]\n" +
        "}";
    private string? _message;
    private string? _visualMessage;
    private IReadOnlyList<string> _validationErrors = [];
    private ScenarioExecutionResult? _testRunResult;
    private ScenarioVisualModel? _visualModel;

    private bool IsBusy => _busy || _testRunBusy;

    private string ExportHref =>
        "data:application/json;charset=utf-8;base64," +
        Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(_json));

    private string ExportFileName
    {
        get
        {
            var candidate = _fileName.Trim();

            try
            {
                ScenarioFileName.Validate(candidate);
                return candidate;
            }
            catch (ArgumentException)
            {
                return "scenario.json";
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _isNew = string.IsNullOrWhiteSpace(FileName);
        _fileName = FileName ?? string.Empty;
        _message = null;
        _visualMessage = null;
        _validationErrors = [];
        _confirmDelete = false;

        if (_isNew)
        {
            SyncVisualFromJson();
            return;
        }

        var document = await ScenarioManagement.GetAsync(FileName!);
        if (document is null)
        {
            _message = "Scenario file was not found.";
            return;
        }

        _json = document.Json;
        SyncVisualFromJson();
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        _busy = true;
        _message = null;
        _validationErrors = [];

        try
        {
            var file = args.File;

            if (!file.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
            {
                _validationErrors = ["Select a .json scenario file."];
                return;
            }

            if (file.Size > MaxImportBytes)
            {
                _validationErrors =
                [
                    $"Scenario JSON must be no larger than {MaxImportBytes / 1024} KiB."
                ];
                return;
            }

            await using var stream = file.OpenReadStream(MaxImportBytes);
            using var reader = new StreamReader(stream);
            _json = await reader.ReadToEndAsync();

            if (_isNew)
            {
                try
                {
                    ScenarioFileName.Validate(file.Name);
                    _fileName = file.Name;
                }
                catch (ArgumentException)
                {
                    // Keep the current file name. SaveAsync will still enforce
                    // the normal path-safe .json naming rules.
                }
            }

            var validation = ScenarioJsonValidation.Validate(_json);
            _validationErrors = validation.Errors;

            if (validation.IsValid)
            {
                SyncVisualFromJson();
            }
            else
            {
                _visualModel = null;
                _visualMessage = "Fix the imported JSON validation errors to use the visual editor.";
            }

            _message = validation.IsValid
                ? $"Imported {file.Name}. Review the scenario and save when ready."
                : $"Imported {file.Name}, but validation found issues.";
        }
        catch (IOException)
        {
            _validationErrors = ["The selected scenario file could not be read."];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunTestAsync()
    {
        _testRunBusy = true;
        _message = null;
        _validationErrors = [];
        _testRunResult = null;

        _testRunCancellation?.Dispose();
        _testRunCancellation = new CancellationTokenSource();

        try
        {
            var result = await ScenarioTestRun.RunAsync(
                _json,
                _testRunCancellation.Token);

            _validationErrors = result.Errors;
            _testRunResult = result.Execution;

            if (!result.Executed)
            {
                _message = null;
                return;
            }

            _message = result.Success
                ? "Test run completed successfully."
                : "Test run failed. See the result below.";
        }
        catch (OperationCanceledException)
        {
            _message = "Test run cancelled.";
        }
        finally
        {
            _testRunBusy = false;
            _testRunCancellation?.Dispose();
            _testRunCancellation = null;
        }
    }

    private void CancelTestRun() =>
        _testRunCancellation?.Cancel();

    private Task ValidateAsync()
    {
        var validation = ScenarioJsonValidation.Validate(_json);
        _validationErrors = validation.Errors;

        if (validation.IsValid)
        {
            SyncVisualFromJson();
        }
        else
        {
            _visualModel = null;
            _visualMessage = "Fix the JSON validation errors to use the visual editor.";
        }

        _message = validation.IsValid
            ? "Scenario JSON is valid."
            : null;

        return Task.CompletedTask;
    }

    private Task JsonChangedAsync()
    {
        _message = null;
        _testRunResult = null;

        var validation = ScenarioJsonValidation.Validate(_json);
        _validationErrors = validation.Errors;

        if (!validation.IsValid)
        {
            _visualModel = null;
            _visualMessage = "Fix the JSON validation errors to use the visual editor.";
            return Task.CompletedTask;
        }

        SyncVisualFromJson();
        return Task.CompletedTask;
    }

    private Task VisualChangedAsync()
    {
        if (_visualModel is null)
        {
            return Task.CompletedTask;
        }

        _json = _visualModel.ToJson();
        _message = null;
        _visualMessage = null;
        _testRunResult = null;

        var validation = ScenarioJsonValidation.Validate(_json);
        _validationErrors = validation.Errors;

        return Task.CompletedTask;
    }

    private async Task AddVisualStepAsync()
    {
        if (_visualModel is null || IsBusy)
        {
            return;
        }

        _visualModel.AddStep();
        await VisualChangedAsync();
    }

    private async Task MoveVisualStepAsync(
        ScenarioVisualStepModel step,
        int offset)
    {
        if (_visualModel is null || IsBusy)
        {
            return;
        }

        if (_visualModel.MoveStep(step, offset))
        {
            await VisualChangedAsync();
        }
    }

    private async Task RemoveVisualStepAsync(
        ScenarioVisualStepModel step)
    {
        if (_visualModel is null || IsBusy)
        {
            return;
        }

        _visualModel.RemoveStep(step);
        await VisualChangedAsync();
    }

    private void SyncVisualFromJson()
    {
        if (ScenarioVisualModel.TryCreate(
                _json,
                out var model,
                out var errors))
        {
            _visualModel = model;
            _visualMessage = null;
            return;
        }

        _visualModel = null;
        _visualMessage = errors.Count > 0
            ? "Fix the JSON validation errors to use the visual editor."
            : "The scenario could not be loaded into the visual editor.";
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _message = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_fileName))
            {
                _validationErrors = ["File name is required."];
                return;
            }

            var result = await ScenarioManagement.SaveAsync(
                _fileName.Trim(),
                _json,
                overwrite: !_isNew);

            _validationErrors = result.Errors;
            if (!result.Success)
            {
                return;
            }

            if (_isNew)
            {
                Navigation.NavigateTo(
                    $"scenarios/{Uri.EscapeDataString(_fileName.Trim())}");
                return;
            }

            _message = "Scenario saved.";
        }
        catch (ArgumentException exception)
        {
            _validationErrors = [exception.Message];
        }
        finally
        {
            _busy = false;
        }
    }

    private void RequestDelete()
    {
        _confirmDelete = true;
        _message = "Confirm deletion. This removes the scenario file.";
    }

    private void CancelDelete()
    {
        _confirmDelete = false;
        _message = null;
    }

    public void Dispose()
    {
        _testRunCancellation?.Cancel();
        _testRunCancellation?.Dispose();
    }

    private async Task DeleteAsync()
    {
        if (_isNew || string.IsNullOrWhiteSpace(FileName))
        {
            return;
        }

        _busy = true;
        _message = null;

        try
        {
            await ScenarioManagement.DeleteAsync(FileName);
            Navigation.NavigateTo("scenarios");
        }
        catch (ArgumentException exception)
        {
            _validationErrors = [exception.Message];
        }
        finally
        {
            _busy = false;
        }
    }
}
