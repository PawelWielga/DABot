@using Microsoft.Extensions.Logging
@page "/events"
@inject IAdministrativeEventService AdministrativeEvents
@inject IEventHistoryQueryService EventHistory
@inject ManagementUiEnvironment UiEnvironment
@inject ILogger<Events> Logger

<PageTitle>DABot events</PageTitle>

<div class="page-heading">
    <div>
        <h1>Events</h1>
        <p class="lead">Durable event inbox history and resume-work state.</p>
    </div>
    <span class="muted">@FilteredEvents.Count event(s)</span>
</div>

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Publish event</h2>
            <p>Inject a transport-neutral event into the same durable inbox used by observers and external adapters.</p>
        </div>
    </div>

    <div class="configuration-grid">
        <label class="configuration-wide">
            <span>Event ID</span>
            <input type="text"
                   @bind="_eventId"
                   disabled="@PublishDisabled" />
            <small>Reuse the same ID when intentionally retrying delivery. Duplicate IDs are idempotent.</small>
        </label>

        <label>
            <span>Type</span>
            <input type="text"
                   @bind="_eventType"
                   placeholder="order.approved"
                   disabled="@PublishDisabled" />
        </label>

        <label>
            <span>Correlation ID</span>
            <input type="text"
                   @bind="_correlationId"
                   placeholder="order-123"
                   disabled="@PublishDisabled" />
        </label>

        <label class="configuration-wide">
            <span>Payload JSON</span>
            <textarea rows="6"
                      @bind="_payloadJson"
                      disabled="@PublishDisabled"></textarea>
            <small>The payload is persisted for workflow resume but is not exposed by event-history queries.</small>
        </label>
    </div>

    @if (_publishErrors.Count > 0)
    {
        <div class="scenario-errors">
            @foreach (var error in _publishErrors)
            {
                <div>@error</div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_publishMessage))
    {
        <p class="action-message">@_publishMessage</p>
    }

    @if (!string.IsNullOrWhiteSpace(_publishError))
    {
        <p class="action-error">@_publishError</p>
    }

    <div class="button-row">
        <button class="button primary"
                type="button"
                @onclick="PublishAsync"
                disabled="@PublishDisabled">
            @(_publishing ? "Publishing…" : "Publish event")
        </button>
        <button class="button secondary"
                type="button"
                @onclick="NewEventId"
                disabled="@_publishing">
            New event ID
        </button>
    </div>

    @if (UiEnvironment.IsDemo)
    {
        <p class="muted action-note">Event publishing is disabled in the static demo.</p>
    }
</section>

<section class="panel">
    @if (_loading)
    {
        <p>Loading events…</p>
    }
    else
    {
        <div class="filters">
            <label>
                <span>Status</span>
                <select @bind="_statusFilter">
                    <option value="">All</option>
                    <option value="matched">Matched</option>
                    <option value="unmatched">Unmatched</option>
                    <option value="problems">Problems</option>
                </select>
            </label>

            <label>
                <span>Search</span>
                <input @bind="_search"
                       @bind:event="oninput"
                       placeholder="Type, correlation, event or run ID" />
            </label>
        </div>

        @if (FilteredEvents.Count == 0)
        {
            <p class="muted">No events match the current filters.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Received</th>
                            <th>Correlation</th>
                            <th>Run</th>
                            <th>Resume work</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredEvents)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Type</strong>
                                    <div class="muted compact-text">@item.EventId</div>
                                </td>
                                <td>
                                    @FormatTimestamp(item.ReceivedAt)
                                    <div class="muted compact-text">
                                        occurred @FormatTimestamp(item.OccurredAt)
                                    </div>
                                </td>
                                <td>@item.CorrelationId</td>
                                <td>
                                    @if (item.RunId is Guid runId)
                                    {
                                        <span class="status completed">Matched</span>
                                        <div class="compact-text">
                                            <a href="@($"runs/{runId:D}")">@runId</a>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="status cancelled">Unmatched</span>
                                    }
                                </td>
                                <td class="error-cell">
                                    @if (item.WorkItemId is null)
                                    {
                                        <span class="muted">No resume work</span>
                                    }
                                    else
                                    {
                                        <span class="status @StatusCss(item.WorkItemStatus)">
                                            @(item.WorkItemStatus?.ToString() ?? "Unknown")
                                        </span>
                                        <div class="muted compact-text">
                                            @item.WorkItemId
                                        </div>
                                        @if (item.AttemptCount is int attempts)
                                        {
                                            <div class="muted compact-text">
                                                @attempts attempt(s)
                                            </div>
                                        }
                                        @if (item.NextAttemptAt is not null)
                                        {
                                            <div class="muted compact-text">
                                                next @FormatTimestamp(item.NextAttemptAt.Value)
                                            </div>
                                        }
                                        @if (item.FinishedAt is not null)
                                        {
                                            <div class="muted compact-text">
                                                finished @FormatTimestamp(item.FinishedAt.Value)
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
                                        {
                                            <div class="muted compact-text">@item.ErrorMessage</div>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

<p class="muted">
    Event payloads are intentionally not exposed by this management view.
</p>

@code {
    private bool _loading = true;
    private bool _publishing;
    private string _eventId = Guid.NewGuid().ToString("D");
    private string _eventType = string.Empty;
    private string _correlationId = string.Empty;
    private string _payloadJson = "{}";
    private string _statusFilter = string.Empty;
    private string _search = string.Empty;
    private string? _publishMessage;
    private string? _publishError;
    private IReadOnlyList<string> _publishErrors = [];
    private IReadOnlyList<EventHistoryItem> _events = [];

    private bool PublishDisabled =>
        UiEnvironment.IsDemo ||
        _publishing;

    private IReadOnlyList<EventHistoryItem> FilteredEvents =>
        _events
            .Where(MatchesStatus)
            .Where(MatchesSearch)
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        await LoadEventsAsync();
        _loading = false;
    }

    private async Task LoadEventsAsync()
    {
        _events = await EventHistory.ListRecentAsync(limit: 200);
    }

    private async Task PublishAsync()
    {
        if (PublishDisabled)
        {
            return;
        }

        _publishMessage = null;
        _publishError = null;
        _publishErrors = [];

        if (!Guid.TryParse(_eventId, out var eventId) ||
            eventId == Guid.Empty)
        {
            _publishErrors =
                ["Event ID must be a non-empty GUID."];
            return;
        }

        _publishing = true;

        try
        {
            var result = await AdministrativeEvents.PublishAsync(
                new AdministrativeEventPublishRequest
                {
                    EventId = eventId,
                    Type = _eventType,
                    CorrelationId = _correlationId,
                    PayloadJson = _payloadJson,
                });

            if (!result.Success)
            {
                _publishErrors = result.Errors;
                return;
            }

            _publishMessage = result.IsDuplicate
                ? $"Event {result.EventId} was already accepted; no duplicate resume work was scheduled."
                : result.MatchedWaitingRun
                    ? $"Event {result.EventId} accepted and matched run {result.RunId}. Resume work item: {result.ResumeWorkItemId}."
                    : $"Event {result.EventId} accepted. No active waiting run matched it.";

            await LoadEventsAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Administrative event publishing failed.");
            _publishError =
                "The event could not be published. Check server logs for diagnostics.";
        }
        finally
        {
            _publishing = false;
        }
    }

    private void NewEventId()
    {
        _eventId = Guid.NewGuid().ToString("D");
        _publishMessage = null;
        _publishError = null;
        _publishErrors = [];
    }

    private bool MatchesStatus(EventHistoryItem item) =>
        _statusFilter switch
        {
            "matched" => item.MatchedWaitingRun,
            "unmatched" => !item.MatchedWaitingRun,
            "problems" =>
                item.WorkItemStatus is ResumeWorkItemStatus.Failed
                    or ResumeWorkItemStatus.DeadLetter ||
                !string.IsNullOrWhiteSpace(item.ErrorMessage),
            _ => true,
        };

    private bool MatchesSearch(EventHistoryItem item)
    {
        var value = _search.Trim();
        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        return item.Type.Contains(value, StringComparison.OrdinalIgnoreCase) ||
               item.CorrelationId.Contains(value, StringComparison.OrdinalIgnoreCase) ||
               item.EventId.ToString("D").Contains(value, StringComparison.OrdinalIgnoreCase) ||
               (item.RunId?.ToString("D").Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (item.WorkItemId?.ToString("D").Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private static string StatusCss(ResumeWorkItemStatus? status) =>
        status switch
        {
            ResumeWorkItemStatus.Completed => "completed",
            ResumeWorkItemStatus.Pending => "waiting",
            ResumeWorkItemStatus.Failed => "failed",
            ResumeWorkItemStatus.DeadLetter => "failed",
            _ => "cancelled",
        };

    private static string FormatTimestamp(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
}
