@page "/runs/{RunId:guid}"
@inject IRunQueryService RunQueries
@inject IRunArtifactService RunArtifacts
@inject ManagementUiEnvironment UiEnvironment

<PageTitle>DABot run details</PageTitle>

@if (_loading)
{
    <p>Loading run…</p>
}
else if (_run is null)
{
    <div class="page-heading">
        <div>
            <h1>Run not found</h1>
            <p class="lead">The requested durable run does not exist.</p>
        </div>
        <a class="button secondary" href="runs">Back to runs</a>
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Run @ShortId(_run.RunId)</h1>
            <p class="lead">@_run.ScenarioName</p>
        </div>
        <a class="button secondary" href="runs">Back to runs</a>
    </div>

    <section class="detail-grid">
        <article class="detail-card">
            <span>Status</span>
            <strong><span class="status @_run.Status.ToString().ToLowerInvariant()">@_run.Status</span></strong>
        </article>
        <article class="detail-card">
            <span>Wait reason</span>
            <strong>@(_run.WaitReason?.ToString() ?? "—")</strong>
        </article>
        <article class="detail-card">
            <span>Scenario version</span>
            <strong>v@_run.ScenarioVersionNumber</strong>
        </article>
        <article class="detail-card">
            <span>Updated</span>
            <strong>@FormatTime(_run.UpdatedAt)</strong>
        </article>
    </section>

    <section class="panel">
        <h2>Run metadata</h2>
        <dl class="metadata-grid">
            <div>
                <dt>Run ID</dt>
                <dd><code>@_run.RunId</code></dd>
            </div>
            <div>
                <dt>Scenario ID</dt>
                <dd><code>@_run.ScenarioId</code></dd>
            </div>
            <div>
                <dt>Scenario version ID</dt>
                <dd><code>@_run.ScenarioVersionId</code></dd>
            </div>
            <div>
                <dt>Created</dt>
                <dd>@FormatTime(_run.CreatedAt)</dd>
            </div>
            <div>
                <dt>Updated</dt>
                <dd>@FormatTime(_run.UpdatedAt)</dd>
            </div>
            <div>
                <dt>Retry not before</dt>
                <dd>@(_run.RetryNotBefore is null ? "—" : FormatTime(_run.RetryNotBefore.Value))</dd>
            </div>
        </dl>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Artifacts</h2>
                <p>Screenshots and diagnostic files stored for this run.</p>
            </div>
            <span class="muted">@_artifacts.Count artifact(s)</span>
        </div>

        @if (_artifacts.Count == 0)
        {
            <p class="muted">No artifacts are available for this run.</p>
        }
        else
        {
            <div class="artifact-grid">
                @foreach (var artifact in _artifacts)
                {
                    var url = ArtifactUrl(artifact);

                    <article class="artifact-card">
                        @if (artifact.CanPreview &&
                             artifact.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) &&
                             !UiEnvironment.IsDemo)
                        {
                            <a href="@url" target="_blank" rel="noopener noreferrer">
                                <img src="@url"
                                     alt="Preview of @artifact.FileName"
                                     loading="lazy" />
                            </a>
                        }
                        else
                        {
                            <div class="artifact-placeholder">
                                <strong>@ArtifactLabel(artifact)</strong>
                                @if (UiEnvironment.IsDemo)
                                {
                                    <span>Sample artifact</span>
                                }
                                else if (!artifact.CanPreview)
                                {
                                    <span>Download only</span>
                                }
                            </div>
                        }

                        <div class="artifact-meta">
                            <div>
                                <strong>@artifact.FileName</strong>
                                <span>@artifact.Source · @FormatSize(artifact.SizeBytes)</span>
                            </div>

                            @if (!UiEnvironment.IsDemo)
                            {
                                <a class="button secondary"
                                   href="@url"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    @(artifact.CanPreview ? "Open" : "Download")
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>

            @if (UiEnvironment.IsDemo)
            {
                <p class="muted privacy-note">Artifact names and sizes are sample data in the static demo. File access is available only in a connected DABot runtime.</p>
            }
            else
            {
                <p class="muted privacy-note">HTML snapshots are forced to download instead of rendering inline to avoid executing captured page content under the management-panel origin.</p>
            }
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Step history</h2>
                <p>Persisted attempts for this durable run.</p>
            </div>
            <span class="muted">@_run.StepAttempts.Count attempt(s)</span>
        </div>

        @if (_run.StepAttempts.Count == 0)
        {
            <p class="muted">No persisted step attempts.</p>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Step</th>
                            <th>Type</th>
                            <th>Attempt</th>
                            <th>Retry safety</th>
                            <th>Status</th>
                            <th>Started</th>
                            <th>Duration</th>
                            <th>Error</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attempt in _run.StepAttempts)
                        {
                            <tr>
                                <td><code>@attempt.StepId</code></td>
                                <td>@attempt.StepType</td>
                                <td>@attempt.AttemptNumber</td>
                                <td>@attempt.RetrySafety</td>
                                <td><span class="status @attempt.Status.ToString().ToLowerInvariant()">@attempt.Status</span></td>
                                <td>@FormatTime(attempt.StartedAt)</td>
                                <td>@FormatDuration(attempt)</td>
                                <td class="error-cell">@(attempt.ErrorMessage ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Event history</h2>
                <p>Events that matched this run and their durable resume work.</p>
            </div>
            <span class="muted">@_run.Events.Count event(s)</span>
        </div>

        @if (_run.Events.Count == 0)
        {
            <p class="muted">No matched events have been persisted for this run.</p>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Type</th>
                            <th>Correlation</th>
                            <th>Occurred</th>
                            <th>Received</th>
                            <th>Resume status</th>
                            <th>Attempts</th>
                            <th>Next attempt</th>
                            <th>Error</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _run.Events)
                        {
                            <tr>
                                <td><code>@ShortId(item.EventId)</code></td>
                                <td>@item.Type</td>
                                <td><code>@item.CorrelationId</code></td>
                                <td>@FormatTime(item.OccurredAt)</td>
                                <td>@FormatTime(item.ReceivedAt)</td>
                                <td><span class="status @item.WorkItemStatus.ToString().ToLowerInvariant()">@item.WorkItemStatus</span></td>
                                <td>@item.AttemptCount</td>
                                <td>@(item.NextAttemptAt is null ? "—" : FormatTime(item.NextAttemptAt.Value))</td>
                                <td class="error-cell">@(item.ErrorMessage ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <p class="muted privacy-note">Event payloads are intentionally not exposed by the web read model.</p>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Variables</h2>
                <p>Structured persisted run variables.</p>
            </div>
            <span class="muted">@_run.Variables.Count variable(s)</span>
        </div>

        @if (_run.Variables.Count == 0)
        {
            <p class="muted">No persisted variables.</p>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var variable in _run.Variables)
                        {
                            <tr>
                                <td><code>@variable.Name</code></td>
                                <td>@variable.Kind</td>
                                <td class="value-cell"><code>@variable.Value</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public Guid RunId { get; set; }

    private bool _loading = true;
    private RunDetail? _run;
    private IReadOnlyList<RunArtifactItem> _artifacts = [];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _run = await RunQueries.GetRunAsync(RunId);
        _artifacts = _run is null
            ? []
            : await RunArtifacts.ListAsync(RunId);
        _loading = false;
    }

    private static string ShortId(Guid id) =>
        id.ToString("D")[..8];

    private static string FormatTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

    private string ArtifactUrl(RunArtifactItem artifact) =>
        $"api/runs/{RunId:D}/artifacts/{artifact.Source}/{Uri.EscapeDataString(artifact.FileName)}";

    private static string ArtifactLabel(RunArtifactItem artifact) =>
        artifact.Source == RunArtifactSource.Screenshots
            ? "Screenshot"
            : Path.GetExtension(artifact.FileName).ToLowerInvariant() switch
            {
                ".json" => "JSON",
                ".html" or ".htm" => "HTML",
                ".txt" => "Text",
                _ => "Artifact",
            };

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        var kilobytes = bytes / 1024d;
        if (kilobytes < 1024)
        {
            return $"{kilobytes:0.#} KB";
        }

        return $"{kilobytes / 1024d:0.#} MB";
    }

    private static string FormatDuration(RunStepAttemptItem attempt)
    {
        var end = attempt.FinishedAt ?? attempt.UpdatedAt;
        var duration = end - attempt.StartedAt;

        return duration.TotalSeconds >= 1
            ? $"{duration.TotalSeconds:0.###} s"
            : $"{duration.TotalMilliseconds:0} ms";
    }
}
