@using Microsoft.Extensions.Logging
@page "/runs/{RunId:guid}"
@inject IRunQueryService RunQueries
@inject IRunArtifactService RunArtifacts
@inject IDurableRunControlService RunControl
@inject ManagementUiEnvironment UiEnvironment
@inject NavigationManager Navigation
@inject ILogger<RunDetails> Logger

<PageTitle>DABot run details</PageTitle>

@if (_loading)
{
    <p>Loading run…</p>
}
else if (_run is null)
{
    <div class="page-heading">
        <div>
            <h1>Run not found</h1>
            <p class="lead">The requested durable run does not exist.</p>
        </div>
        <a class="button secondary" href="runs">Back to runs</a>
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Run @ShortId(_run.RunId)</h1>
            <p class="lead">@_run.ScenarioName</p>
        </div>
        <a class="button secondary" href="runs">Back to runs</a>
    </div>

    <section class="detail-grid">
        <article class="detail-card">
            <span>Status</span>
            <strong><span class="status @_run.Status.ToString().ToLowerInvariant()">@_run.Status</span></strong>
        </article>
        <article class="detail-card">
            <span>Wait reason</span>
            <strong>@(_run.WaitReason?.ToString() ?? "—")</strong>
        </article>
        <article class="detail-card">
            <span>Scenario version</span>
            <strong>v@_run.ScenarioVersionNumber</strong>
        </article>
        <article class="detail-card">
            <span>Updated</span>
            <strong>@FormatTime(_run.UpdatedAt)</strong>
        </article>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Run actions</h2>
                <p>Manual control uses the same durable Application services as the CLI.</p>
            </div>
            <span class="muted">@RunActionSummary</span>
        </div>

        @if (UiEnvironment.IsDemo)
        {
            <p class="muted">Run actions are disabled in the static demo. Connect the management panel to a DABot runtime to execute them.</p>
        }
        else
        {
            <div class="button-row run-action-buttons">
                <button class="button primary"
                        type="button"
                        @onclick="ResumeAsync"
                        disabled="@(_actionBusy || !CanResume)">
                    @(_actionBusy && _activeAction == "resume" ? "Resuming…" : "Resume")
                </button>

                <button class="button secondary"
                        type="button"
                        @onclick="RetryNowAsync"
                        disabled="@(_actionBusy || !CanRetry)">
                    @(_actionBusy && _activeAction == "retry" ? "Retrying…" : "Retry now")
                </button>

                @if (_confirmClone)
                {
                    <button class="button primary"
                            type="button"
                            @onclick="CloneAsync"
                            disabled="@_actionBusy">
                        @(_actionBusy && _activeAction == "clone" ? "Cloning…" : "Confirm clone")
                    </button>
                    <button class="button secondary"
                            type="button"
                            @onclick="DismissClone"
                            disabled="@_actionBusy">
                        Keep run
                    </button>
                }
                else
                {
                    <button class="button secondary"
                            type="button"
                            @onclick="RequestClone"
                            disabled="@(_actionBusy || !CanClone)">
                        Clone run
                    </button>
                }

                @if (_confirmCancel)
                {
                    <button class="button danger"
                            type="button"
                            @onclick="CancelAsync"
                            disabled="@_actionBusy">
                        @(_actionBusy && _activeAction == "cancel" ? "Cancelling…" : "Confirm cancel")
                    </button>
                    <button class="button secondary"
                            type="button"
                            @onclick="DismissCancel"
                            disabled="@_actionBusy">
                        Keep run
                    </button>
                }
                else
                {
                    <button class="button danger"
                            type="button"
                            @onclick="RequestCancel"
                            disabled="@(_actionBusy || !CanCancel)">
                        Cancel
                    </button>
                }
            </div>

            @if (_confirmClone)
            {
                <p class="action-warning">Clone this run? A new durable run will start from the beginning using the same immutable scenario version and the source run's original input variables. External side effects may be repeated.</p>
            }
            else if (_confirmCancel)
            {
                <p class="action-warning">Cancel this queued or waiting run? This changes its durable state to Cancelled.</p>
            }
            else if (_run.Status == RunStatus.Waiting && _run.WaitReason == RunWaitReason.Retry)
            {
                <p class="muted action-note">Retry now ignores the scheduled retry time, but still enforces the persisted retry limit and recovery checks.</p>
            }
            else if (_run.Status == RunStatus.Running)
            {
                <p class="muted action-note">Active runs cannot be cancelled safely until worker lease/CAS coordination is implemented.</p>
            }

            @if (!string.IsNullOrWhiteSpace(_actionMessage))
            {
                <p class="action-message">@_actionMessage</p>
            }

            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <p class="action-error">@_actionError</p>
            }
        }
    </section>

    <section class="panel">
        <h2>Run metadata</h2>
        <dl class="metadata-grid">
            <div>
                <dt>Run ID</dt>
                <dd><code>@_run.RunId</code></dd>
            </div>
            <div>
                <dt>Scenario ID</dt>
                <dd><code>@_run.ScenarioId</code></dd>
            </div>
            <div>
                <dt>Scenario version ID</dt>
                <dd><code>@_run.ScenarioVersionId</code></dd>
            </div>
            <div>
                <dt>Created</dt>
                <dd>@FormatTime(_run.CreatedAt)</dd>
            </div>
            <div>
                <dt>Updated</dt>
                <dd>@FormatTime(_run.UpdatedAt)</dd>
            </div>
            <div>
                <dt>Retry not before</dt>
                <dd>@(_run.RetryNotBefore is null ? "—" : FormatTime(_run.RetryNotBefore.Value))</dd>
            </div>
        </dl>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Artifacts</h2>
                <p>Screenshots and diagnostic files stored for this run.</p>
            </div>
            <span class="muted">@_artifacts.Count artifact(s)</span>
        </div>

        @if (_artifacts.Count == 0)
        {
            <p class="muted">No artifacts are available for this run.</p>
        }
        else
        {
            <div class="artifact-grid">
                @foreach (var artifact in _artifacts)
                {
                    var url = ArtifactUrl(artifact);

                    <article class="artifact-card">
                        @if (artifact.CanPreview &&
                             artifact.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) &&
                             !UiEnvironment.IsDemo)
                        {
                            <a href="@url" target="_blank" rel="noopener noreferrer">
                                <img src="@url"
                                     alt="Preview of @artifact.FileName"
                                     loading="lazy" />
                            </a>
                        }
                        else
                        {
                            <div class="artifact-placeholder">
                                <strong>@ArtifactLabel(artifact)</strong>
                                @if (UiEnvironment.IsDemo)
                                {
                                    <span>Sample artifact</span>
                                }
                                else if (!artifact.CanPreview)
                                {
                                    <span>Download only</span>
                                }
                            </div>
                        }

                        <div class="artifact-meta">
                            <div>
                                <strong>@artifact.FileName</strong>
                                <span>@artifact.Source · @FormatSize(artifact.SizeBytes)</span>
                            </div>

                            @if (!UiEnvironment.IsDemo)
                            {
                                <a class="button secondary"
                                   href="@url"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    @(artifact.CanPreview ? "Open" : "Download")
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>

            @if (UiEnvironment.IsDemo)
            {
                <p class="muted privacy-note">Artifact names and sizes are sample data in the static demo. File access is available only in a connected DABot runtime.</p>
            }
            else
            {
                <p class="muted privacy-note">HTML snapshots are forced to download instead of rendering inline to avoid executing captured page content under the management-panel origin.</p>
            }
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Step history</h2>
                <p>Persisted attempts for this durable run.</p>
            </div>
            <span class="muted">@_run.StepAttempts.Count attempt(s)</span>
        </div>

        @if (_run.StepAttempts.Count == 0)
        {
            <p class="muted">No persisted step attempts.</p>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Step</th>
                            <th>Type</th>
                            <th>Attempt</th>
                            <th>Retry safety</th>
                            <th>Status</th>
                            <th>Started</th>
                            <th>Duration</th>
                            <th>Error</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attempt in _run.StepAttempts)
                        {
                            <tr>
                                <td><code>@attempt.StepId</code></td>
                                <td>@attempt.StepType</td>
                                <td>@attempt.AttemptNumber</td>
                                <td>@attempt.RetrySafety</td>
                                <td><span class="status @attempt.Status.ToString().ToLowerInvariant()">@attempt.Status</span></td>
                                <td>@FormatTime(attempt.StartedAt)</td>
                                <td>@FormatDuration(attempt)</td>
                                <td class="error-cell">@(attempt.ErrorMessage ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Event history</h2>
                <p>Events that matched this run and their durable resume work.</p>
            </div>
            <span class="muted">@_run.Events.Count event(s)</span>
        </div>

        @if (_run.Events.Count == 0)
        {
            <p class="muted">No matched events have been persisted for this run.</p>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Type</th>
                            <th>Correlation</th>
                            <th>Occurred</th>
                            <th>Received</th>
                            <th>Resume status</th>
                            <th>Attempts</th>
                            <th>Next attempt</th>
                            <th>Error</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _run.Events)
                        {
                            <tr>
                                <td><code>@ShortId(item.EventId)</code></td>
                                <td>@item.Type</td>
                                <td><code>@item.CorrelationId</code></td>
                                <td>@FormatTime(item.OccurredAt)</td>
                                <td>@FormatTime(item.ReceivedAt)</td>
                                <td><span class="status @item.WorkItemStatus.ToString().ToLowerInvariant()">@item.WorkItemStatus</span></td>
                                <td>@item.AttemptCount</td>
                                <td>@(item.NextAttemptAt is null ? "—" : FormatTime(item.NextAttemptAt.Value))</td>
                                <td class="error-cell">@(item.ErrorMessage ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <p class="muted privacy-note">Event payloads are intentionally not exposed by the web read model.</p>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Variables</h2>
                <p>Structured persisted run variables.</p>
            </div>
            <span class="muted">@_run.Variables.Count variable(s)</span>
        </div>

        @if (_run.Variables.Count == 0)
        {
            <p class="muted">No persisted variables.</p>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var variable in _run.Variables)
                        {
                            <tr>
                                <td><code>@variable.Name</code></td>
                                <td>@variable.Kind</td>
                                <td class="value-cell"><code>@variable.Value</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public Guid RunId { get; set; }

    private bool _loading = true;
    private bool _actionBusy;
    private bool _confirmClone;
    private bool _confirmCancel;
    private string? _activeAction;
    private string? _actionMessage;
    private string? _actionError;
    private RunDetail? _run;
    private IReadOnlyList<RunArtifactItem> _artifacts = [];

    private bool CanResume =>
        !UiEnvironment.IsDemo &&
        _run is { Status: RunStatus.Waiting } &&
        _run.WaitReason != RunWaitReason.Retry;

    private bool CanRetry =>
        !UiEnvironment.IsDemo &&
        _run is { Status: RunStatus.Waiting, WaitReason: RunWaitReason.Retry };

    private bool CanCancel =>
        !UiEnvironment.IsDemo &&
        _run is not null &&
        _run.Status is RunStatus.Queued or RunStatus.Waiting;

    private bool CanClone =>
        !UiEnvironment.IsDemo &&
        _run is not null;

    private string RunActionSummary =>
        _run is null
            ? "Unavailable"
            : CanResume || CanRetry || CanCancel || CanClone
                ? "Actions available"
                : "No safe manual action";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _confirmClone = false;
        _confirmCancel = false;
        _actionMessage = null;
        _actionError = null;
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _run = await RunQueries.GetRunAsync(RunId);
        _artifacts = _run is null
            ? []
            : await RunArtifacts.ListAsync(RunId);
    }

    private void RequestClone()
    {
        if (!CanClone || _actionBusy)
        {
            return;
        }

        _confirmClone = true;
        _confirmCancel = false;
        _actionMessage = null;
        _actionError = null;
    }

    private void DismissClone() =>
        _confirmClone = false;

    private void RequestCancel()
    {
        if (!CanCancel || _actionBusy)
        {
            return;
        }

        _confirmCancel = true;
        _confirmClone = false;
        _actionMessage = null;
        _actionError = null;
    }

    private void DismissCancel() =>
        _confirmCancel = false;

    private async Task ResumeAsync()
    {
        if (!CanResume || _run is null || _actionBusy)
        {
            return;
        }

        _actionBusy = true;
        _activeAction = "resume";
        _confirmClone = false;
        _confirmCancel = false;
        _actionMessage = null;
        _actionError = null;

        try
        {
            var result = await RunControl.ResumeManuallyAsync(_run.RunId);
            _actionMessage = $"Resume finished with run state {result.Run.State.Status}.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to resume durable run {RunId}.", RunId);
            _actionError = SafeActionError(exception, "Resume");
        }
        finally
        {
            await ReloadAsync();
            _activeAction = null;
            _actionBusy = false;
        }
    }

    private async Task RetryNowAsync()
    {
        if (!CanRetry || _run is null || _actionBusy)
        {
            return;
        }

        _actionBusy = true;
        _activeAction = "retry";
        _confirmClone = false;
        _confirmCancel = false;
        _actionMessage = null;
        _actionError = null;

        try
        {
            var result = await RunControl.RetryNowAsync(_run.RunId);
            _actionMessage = $"Retry finished with run state {result.Run.State.Status}.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to retry durable run {RunId}.", RunId);
            _actionError = SafeActionError(exception, "Retry");
        }
        finally
        {
            await ReloadAsync();
            _activeAction = null;
            _actionBusy = false;
        }
    }

    private async Task CloneAsync()
    {
        if (!CanClone || _run is null || _actionBusy)
        {
            return;
        }

        _actionBusy = true;
        _activeAction = "clone";
        _confirmClone = false;
        _confirmCancel = false;
        _actionMessage = null;
        _actionError = null;
        Guid? clonedRunId = null;

        try
        {
            var result = await RunControl.CloneAsync(_run.RunId);
            clonedRunId = result.Run.RunId;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to clone durable run {RunId}.", RunId);
            _actionError = SafeActionError(exception, "Clone");
        }
        finally
        {
            if (clonedRunId is null)
            {
                await ReloadAsync();
            }

            _activeAction = null;
            _actionBusy = false;
        }

        if (clonedRunId is not null)
        {
            Navigation.NavigateTo($"runs/{clonedRunId:D}");
        }
    }

    private async Task CancelAsync()
    {
        if (!CanCancel || _run is null || _actionBusy)
        {
            return;
        }

        _actionBusy = true;
        _activeAction = "cancel";
        _confirmClone = false;
        _actionMessage = null;
        _actionError = null;

        try
        {
            var cancelled = await RunControl.CancelAsync(_run.RunId);
            _actionMessage = $"Run state is now {cancelled.State.Status}.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to cancel durable run {RunId}.", RunId);
            _actionError = SafeActionError(exception, "Cancel");
        }
        finally
        {
            _confirmCancel = false;
            await ReloadAsync();
            _activeAction = null;
            _actionBusy = false;
        }
    }

    private static string SafeActionError(
        Exception exception,
        string action) =>
        exception is InvalidOperationException or KeyNotFoundException or ArgumentException
            ? exception.Message
            : $"{action} failed. The run details were refreshed; check server logs for diagnostics.";

    private static string ShortId(Guid id) =>
        id.ToString("D")[..8];

    private static string FormatTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

    private string ArtifactUrl(RunArtifactItem artifact) =>
        $"api/runs/{RunId:D}/artifacts/{artifact.Source}/{Uri.EscapeDataString(artifact.FileName)}";

    private static string ArtifactLabel(RunArtifactItem artifact) =>
        artifact.Source == RunArtifactSource.Screenshots
            ? "Screenshot"
            : Path.GetExtension(artifact.FileName).ToLowerInvariant() switch
            {
                ".json" => "JSON",
                ".html" or ".htm" => "HTML",
                ".txt" => "Text",
                _ => "Artifact",
            };

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        var kilobytes = bytes / 1024d;
        if (kilobytes < 1024)
        {
            return $"{kilobytes:0.#} KB";
        }

        return $"{kilobytes / 1024d:0.#} MB";
    }

    private static string FormatDuration(RunStepAttemptItem attempt)
    {
        var end = attempt.FinishedAt ?? attempt.UpdatedAt;
        var duration = end - attempt.StartedAt;

        return duration.TotalSeconds >= 1
            ? $"{duration.TotalSeconds:0.###} s"
            : $"{duration.TotalMilliseconds:0} ms";
    }
}
