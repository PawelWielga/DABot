@using Microsoft.Extensions.Logging
@page "/profiles"
@inject IBrowserProfileCatalog ProfileCatalog
@inject IBrowserProfileService ProfileService
@inject IBrowserProfileManagementService ProfileManagement
@inject IInteractiveBrowserSessionService InteractiveSessions
@inject ManagementUiEnvironment UiEnvironment
@inject ILogger<Profiles> Logger

<PageTitle>DABot browser profiles</PageTitle>

<div class="page-heading">
    <div>
        <h1>Browser profiles</h1>
        <p class="lead">Persistent browser profiles available to scenarios and interactive setup.</p>
    </div>
    <span class="muted">@UiEnvironment.RuntimeLabel</span>
</div>

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Create profile</h2>
            <p>Create an empty persistent profile directory before using it in a scenario or interactive setup.</p>
        </div>
    </div>

    <div class="profile-create-row">
        <input type="text"
               maxlength="64"
               placeholder="work-account"
               aria-label="New browser profile name"
               @bind="_newProfileName"
               disabled="@(UiEnvironment.IsDemo || IsBusy)" />
        <button class="button primary"
                type="button"
                @onclick="CreateProfileAsync"
                disabled="@(UiEnvironment.IsDemo || IsBusy || string.IsNullOrWhiteSpace(_newProfileName))">
            @(_mutationBusy && _activeAction == "create" ? "Creating…" : "Create profile")
        </button>
    </div>

    @if (UiEnvironment.IsDemo)
    {
        <p class="muted action-note">Profile mutations are disabled in the static demo.</p>
    }

    @if (!string.IsNullOrWhiteSpace(_actionMessage))
    {
        <p class="action-message">@_actionMessage</p>
    }

    @if (!string.IsNullOrWhiteSpace(_actionError))
    {
        <p class="action-error">@_actionError</p>
    }
</section>

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Persistent profiles</h2>
            <p>Profiles keep browser session data between runs. Listing profiles does not open Chromium or acquire a profile lease.</p>
        </div>
        <div class="profile-summary-actions">
            <span class="muted">@(_loading ? "Loading…" : $"{_profiles.Count} profile(s)")</span>
            <button class="button secondary"
                    type="button"
                    @onclick="ReloadInteractiveSessionsAsync"
                    disabled="@IsBusy">
                Refresh sessions
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <p>Loading profiles…</p>
    }
    else if (_profiles.Count == 0)
    {
        <p class="muted">No persistent browser profiles have been created yet.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Usage</th>
                        <th>Health</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var profile in _profiles)
                    {
                        <tr>
                            <td><code>@profile.Name</code></td>
                            <td>Persistent</td>
                            <td>Set <code>browserProfile</code> in a scenario to use this profile.</td>
                            <td>
                                <div class="profile-actions">
                                    <button class="button secondary"
                                            type="button"
                                            @onclick="async () => await TestProfileAsync(profile.Name)"
                                            disabled="@(UiEnvironment.IsDemo || IsBusy || HasInteractiveSession(profile.Name))">
                                        @(_testingProfile == profile.Name ? "Testing…" : "Test")
                                    </button>

                                    @if (_testResults.TryGetValue(profile.Name, out var testResult))
                                    {
                                        <span class="profile-test-result @(testResult.Success ? "success" : "failure")">
                                            @(testResult.Success ? "Healthy" : $"Failed: {testResult.ErrorMessage}")
                                        </span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (_renamingProfile == profile.Name)
                                {
                                    <div class="profile-row-actions">
                                        <input class="profile-rename-input"
                                               type="text"
                                               maxlength="64"
                                               aria-label="New name for @profile.Name"
                                               @bind="_renameProfileName"
                                               disabled="@IsBusy" />
                                        <button class="button primary"
                                                type="button"
                                                @onclick="RenameProfileAsync"
                                                disabled="@(IsBusy || string.IsNullOrWhiteSpace(_renameProfileName))">
                                            @(_mutationBusy && _activeAction == "rename" ? "Saving…" : "Save")
                                        </button>
                                        <button class="button secondary"
                                                type="button"
                                                @onclick="CancelRename"
                                                disabled="@IsBusy">
                                            Cancel
                                        </button>
                                    </div>
                                }
                                else if (_clearProfile == profile.Name)
                                {
                                    <div class="profile-row-actions">
                                        <button class="button danger"
                                                type="button"
                                                @onclick="ClearProfileAsync"
                                                disabled="@IsBusy">
                                            @(_mutationBusy && _activeAction == "clear" ? "Clearing…" : "Confirm clear")
                                        </button>
                                        <button class="button secondary"
                                                type="button"
                                                @onclick="CancelClear"
                                                disabled="@IsBusy">
                                            Keep data
                                        </button>
                                    </div>
                                }
                                else if (_deleteProfile == profile.Name)
                                {
                                    <div class="profile-row-actions">
                                        <button class="button danger"
                                                type="button"
                                                @onclick="DeleteProfileAsync"
                                                disabled="@IsBusy">
                                            @(_mutationBusy && _activeAction == "delete" ? "Deleting…" : "Confirm delete")
                                        </button>
                                        <button class="button secondary"
                                                type="button"
                                                @onclick="CancelDelete"
                                                disabled="@IsBusy">
                                            Keep profile
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="profile-row-actions">
                                        @if (_interactiveSessions.TryGetValue(profile.Name, out var interactiveSession))
                                        {
                                            <button class="button danger"
                                                    type="button"
                                                    @onclick="async () => await StopInteractiveSessionAsync(interactiveSession)"
                                                    disabled="@(UiEnvironment.IsDemo || IsBusy)">
                                                @(_interactiveBusyProfile == profile.Name ? "Closing…" : "Close browser")
                                            </button>
                                            <span class="profile-session-state">
                                                Headed browser open since @FormatTime(interactiveSession.StartedAt)
                                            </span>
                                        }
                                        else
                                        {
                                            <button class="button primary"
                                                    type="button"
                                                    @onclick="async () => await StartInteractiveSessionAsync(profile.Name)"
                                                    disabled="@(UiEnvironment.IsDemo || IsBusy)">
                                                @(_interactiveBusyProfile == profile.Name ? "Opening…" : "Open browser")
                                            </button>
                                            <button class="button secondary"
                                                    type="button"
                                                    @onclick="() => RequestRename(profile.Name)"
                                                    disabled="@(UiEnvironment.IsDemo || IsBusy)">
                                                Rename
                                            </button>
                                            <button class="button secondary"
                                                    type="button"
                                                    @onclick="() => RequestClear(profile.Name)"
                                                    disabled="@(UiEnvironment.IsDemo || IsBusy)">
                                                Clear
                                            </button>
                                            <button class="button danger"
                                                    type="button"
                                                    @onclick="() => RequestDelete(profile.Name)"
                                                    disabled="@(UiEnvironment.IsDemo || IsBusy)">
                                                Delete
                                            </button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (UiEnvironment.IsDemo)
    {
        <p class="muted privacy-note">These are representative demo profiles. Runtime profile tests, mutations, and interactive browser sessions are disabled in the static demo.</p>
    }
    else
    {
        <p class="muted privacy-note">Interactive setup opens a real headed Chromium window on the runtime node and holds the same exclusive profile lease used by runs and observers. Closing the browser window or choosing Close browser releases the session. Remote display streaming to the panel is not implemented yet.</p>
        <p class="muted privacy-note">Profile mutations and health tests use the same exclusive profile lock. Clear removes browser-managed profile data while keeping the named profile available; clear and delete both require explicit confirmation and refuse symlink/reparse-point profiles.</p>
    }
</section>

@code {
    private bool _loading = true;
    private bool _mutationBusy;
    private string? _testingProfile;
    private string? _interactiveBusyProfile;
    private string? _activeAction;
    private string? _renamingProfile;
    private string? _clearProfile;
    private string? _deleteProfile;
    private string _newProfileName = string.Empty;
    private string _renameProfileName = string.Empty;
    private string? _actionMessage;
    private string? _actionError;
    private IReadOnlyList<BrowserProfileListItem> _profiles = [];
    private readonly Dictionary<string, BrowserProfileTestResult> _testResults =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, InteractiveBrowserSessionInfo> _interactiveSessions =
        new(StringComparer.OrdinalIgnoreCase);

    private bool IsBusy =>
        _mutationBusy ||
        _testingProfile is not null ||
        _interactiveBusyProfile is not null;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            ReloadProfilesAsync(),
            ReloadInteractiveSessionsAsync());
        _loading = false;
    }

    private async Task ReloadProfilesAsync() =>
        _profiles = await ProfileCatalog.ListAsync();

    private async Task ReloadInteractiveSessionsAsync()
    {
        var activeSessions = await InteractiveSessions.ListAsync();

        _interactiveSessions.Clear();

        foreach (var activeSession in activeSessions)
        {
            _interactiveSessions[activeSession.ProfileName] = activeSession;
        }
    }

    private bool HasInteractiveSession(string profileName) =>
        _interactiveSessions.ContainsKey(profileName);

    private async Task StartInteractiveSessionAsync(string profileName)
    {
        if (UiEnvironment.IsDemo || IsBusy)
        {
            return;
        }

        _interactiveBusyProfile = profileName;
        ClearActionState();

        try
        {
            var session = await InteractiveSessions.StartAsync(profileName);
            _interactiveSessions[profileName] = session;
            _actionMessage =
                $"Headed browser for '{profileName}' opened on the runtime node. Remote display streaming is not implemented yet.";
        }
        catch (Exception exception)
        {
            HandleMutationError(exception, "Open interactive browser");
        }
        finally
        {
            _interactiveBusyProfile = null;
        }
    }

    private async Task StopInteractiveSessionAsync(
        InteractiveBrowserSessionInfo session)
    {
        if (UiEnvironment.IsDemo || IsBusy)
        {
            return;
        }

        _interactiveBusyProfile = session.ProfileName;
        ClearActionState();

        try
        {
            var stopped = await InteractiveSessions.StopAsync(session.SessionId);
            _interactiveSessions.Remove(session.ProfileName);
            _actionMessage = stopped
                ? $"Interactive browser for '{session.ProfileName}' was closed."
                : $"Interactive browser for '{session.ProfileName}' had already closed.";
        }
        catch (Exception exception)
        {
            HandleMutationError(exception, "Close interactive browser");
        }
        finally
        {
            _interactiveBusyProfile = null;
        }
    }

    private async Task TestProfileAsync(string profileName)
    {
        if (UiEnvironment.IsDemo || IsBusy)
        {
            return;
        }

        _testingProfile = profileName;
        _testResults.Remove(profileName);

        try
        {
            _testResults[profileName] = await ProfileService.TestAsync(profileName);
        }
        finally
        {
            _testingProfile = null;
        }
    }

    private async Task CreateProfileAsync()
    {
        if (UiEnvironment.IsDemo || IsBusy || string.IsNullOrWhiteSpace(_newProfileName))
        {
            return;
        }

        var profileName = _newProfileName.Trim();
        BeginMutation("create");

        try
        {
            await ProfileManagement.CreateAsync(profileName);
            _newProfileName = string.Empty;
            _actionMessage = $"Browser profile '{profileName}' was created.";
            await ReloadProfilesAsync();
        }
        catch (Exception exception)
        {
            HandleMutationError(exception, "Create profile");
        }
        finally
        {
            EndMutation();
        }
    }

    private void RequestRename(string profileName)
    {
        if (UiEnvironment.IsDemo || IsBusy)
        {
            return;
        }

        ClearActionState();
        _clearProfile = null;
        _deleteProfile = null;
        _renamingProfile = profileName;
        _renameProfileName = profileName;
    }

    private void CancelRename()
    {
        if (IsBusy)
        {
            return;
        }

        _renamingProfile = null;
        _renameProfileName = string.Empty;
    }

    private async Task RenameProfileAsync()
    {
        if (UiEnvironment.IsDemo ||
            IsBusy ||
            string.IsNullOrWhiteSpace(_renamingProfile) ||
            string.IsNullOrWhiteSpace(_renameProfileName))
        {
            return;
        }

        var sourceName = _renamingProfile;
        var targetName = _renameProfileName.Trim();
        BeginMutation("rename");

        try
        {
            await ProfileManagement.RenameAsync(sourceName, targetName);
            _testResults.Remove(sourceName);
            _renamingProfile = null;
            _renameProfileName = string.Empty;
            _actionMessage = $"Browser profile '{sourceName}' was renamed to '{targetName}'.";
            await ReloadProfilesAsync();
        }
        catch (Exception exception)
        {
            HandleMutationError(exception, "Rename profile");
        }
        finally
        {
            EndMutation();
        }
    }

    private void RequestClear(string profileName)
    {
        if (UiEnvironment.IsDemo || IsBusy)
        {
            return;
        }

        ClearActionState();
        _renamingProfile = null;
        _renameProfileName = string.Empty;
        _deleteProfile = null;
        _clearProfile = profileName;
    }

    private void CancelClear()
    {
        if (!IsBusy)
        {
            _clearProfile = null;
        }
    }

    private async Task ClearProfileAsync()
    {
        if (UiEnvironment.IsDemo || IsBusy || string.IsNullOrWhiteSpace(_clearProfile))
        {
            return;
        }

        var profileName = _clearProfile;
        BeginMutation("clear");

        try
        {
            await ProfileManagement.ClearAsync(profileName);
            _testResults.Remove(profileName);
            _clearProfile = null;
            _actionMessage = $"Browser profile '{profileName}' was cleared. The profile remains available for new browser state.";
        }
        catch (Exception exception)
        {
            HandleMutationError(exception, "Clear profile");
        }
        finally
        {
            EndMutation();
        }
    }

    private void RequestDelete(string profileName)
    {
        if (UiEnvironment.IsDemo || IsBusy)
        {
            return;
        }

        ClearActionState();
        _renamingProfile = null;
        _renameProfileName = string.Empty;
        _clearProfile = null;
        _deleteProfile = profileName;
    }

    private void CancelDelete()
    {
        if (!IsBusy)
        {
            _deleteProfile = null;
        }
    }

    private async Task DeleteProfileAsync()
    {
        if (UiEnvironment.IsDemo || IsBusy || string.IsNullOrWhiteSpace(_deleteProfile))
        {
            return;
        }

        var profileName = _deleteProfile;
        BeginMutation("delete");

        try
        {
            await ProfileManagement.DeleteAsync(profileName);
            _testResults.Remove(profileName);
            _deleteProfile = null;
            _actionMessage = $"Browser profile '{profileName}' was deleted.";
            await ReloadProfilesAsync();
        }
        catch (Exception exception)
        {
            HandleMutationError(exception, "Delete profile");
        }
        finally
        {
            EndMutation();
        }
    }

    private void BeginMutation(string action)
    {
        _mutationBusy = true;
        _activeAction = action;
        ClearActionState();
    }

    private void EndMutation()
    {
        _activeAction = null;
        _mutationBusy = false;
    }

    private void ClearActionState()
    {
        _actionMessage = null;
        _actionError = null;
    }

    private static string FormatTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("HH:mm:ss");

    private void HandleMutationError(
        Exception exception,
        string action)
    {
        Logger.LogError(
            exception,
            "{Action} failed for browser profile management.",
            action);

        _actionError = exception is ArgumentException or InvalidOperationException or NotSupportedException
            ? exception.Message
            : $"{action} failed. Check server logs for diagnostics.";
    }
}
