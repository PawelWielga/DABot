@page "/runs"
@inject IRunQueryService RunQueries

<PageTitle>DABot runs</PageTitle>

<h1>Runs</h1>
<p class="lead">Recent durable runs persisted by the runtime.</p>

<section class="panel">
    @if (_loading)
    {
        <p>Loading runs…</p>
    }
    else
    {
        <RunTable Runs="_runs" EmptyMessage="No durable runs have been persisted yet." />
    }
</section>

@code {
    private bool _loading = true;
    private IReadOnlyList<RunListItem> _runs = [];

    protected override async Task OnInitializedAsync()
    {
        _runs = await RunQueries.ListRecentRunsAsync(limit: 100);
        _loading = false;
    }
}
