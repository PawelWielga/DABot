@page "/scenarios"
@inject IScenarioCatalogQueryService ScenarioCatalog

<PageTitle>DABot scenarios</PageTitle>

<h1>Scenarios</h1>
<p class="lead">Scenario definitions available in the configured scenarios directory.</p>

<section class="panel">
    @if (_loading)
    {
        <p>Loading scenarios…</p>
    }
    else if (_scenarios.Count == 0)
    {
        <p class="muted">No scenario JSON files were found.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>File</th>
                        <th>Schema</th>
                        <th>Steps</th>
                        <th>Browser profile</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var scenario in _scenarios)
                    {
                        <tr>
                            <td>@scenario.Name</td>
                            <td><code>@scenario.FileName</code></td>
                            <td>@(scenario.IsValid ? scenario.SchemaVersion : "-")</td>
                            <td>@(scenario.IsValid ? scenario.StepCount : "-")</td>
                            <td>@(string.IsNullOrWhiteSpace(scenario.BrowserProfile) ? "Ephemeral" : scenario.BrowserProfile)</td>
                            <td>
                                @if (scenario.IsValid)
                                {
                                    <span class="status completed">Valid</span>
                                }
                                else
                                {
                                    <span class="status failed" title="@string.Join(Environment.NewLine, scenario.ValidationErrors)">Invalid</span>
                                }
                            </td>
                        </tr>
                        @if (!scenario.IsValid)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="scenario-errors">
                                        @foreach (var error in scenario.ValidationErrors)
                                        {
                                            <div>@error</div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private IReadOnlyList<ScenarioListItem> _scenarios = [];

    protected override async Task OnInitializedAsync()
    {
        _scenarios = await ScenarioCatalog.ListAsync();
        _loading = false;
    }
}
