@page "/"
@inject IRunQueryService RunQueries

<PageTitle>DABot dashboard</PageTitle>

<h1>Dashboard</h1>
<p class="lead">Read-only overview of the durable automation runtime.</p>

@if (_loading)
{
    <p>Loading runtime state…</p>
}
else
{
    <div class="stat-grid">
        <article class="stat-card">
            <span>Total runs</span>
            <strong>@_summary.TotalRuns</strong>
        </article>
        <article class="stat-card">
            <span>Running</span>
            <strong>@_summary.RunningRuns</strong>
        </article>
        <article class="stat-card">
            <span>Waiting</span>
            <strong>@_summary.WaitingRuns</strong>
        </article>
        <article class="stat-card">
            <span>Failed</span>
            <strong>@_summary.FailedRuns</strong>
        </article>
        <article class="stat-card">
            <span>Completed</span>
            <strong>@_summary.CompletedRuns</strong>
        </article>
        <article class="stat-card">
            <span>Cancelled</span>
            <strong>@_summary.CancelledRuns</strong>
        </article>
    </div>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Recent runs</h2>
                <p>Latest persisted durable executions.</p>
            </div>
            <a href="/runs">View all</a>
        </div>

        <RunTable Runs="_recentRuns" EmptyMessage="No durable runs have been persisted yet." />
    </section>

    <section class="panel two-column">
        <div>
            <h2>Recent failures</h2>
            <RunTable Runs="_recentFailures" EmptyMessage="No recent failed runs." />
        </div>
        <div>
            <h2>Waiting runs</h2>
            <RunTable Runs="_waitingRuns" EmptyMessage="No runs are currently waiting." />
        </div>
    </section>

    <section class="panel">
        <h2>Workers</h2>
        <p class="muted">Worker registry and heartbeat reporting will appear here once multi-worker coordination is implemented.</p>
    </section>
}

@code {
    private bool _loading = true;
    private RunDashboardSummary _summary = new();
    private IReadOnlyList<RunListItem> _recentRuns = [];
    private IReadOnlyList<RunListItem> _recentFailures = [];
    private IReadOnlyList<RunListItem> _waitingRuns = [];

    protected override async Task OnInitializedAsync()
    {
        _summary = await RunQueries.GetDashboardSummaryAsync();
        _recentRuns = await RunQueries.ListRecentRunsAsync(limit: 10);
        _recentFailures = await RunQueries.ListRecentRunsAsync(
            limit: 5,
            status: RunStatus.Failed);
        _waitingRuns = await RunQueries.ListRecentRunsAsync(
            limit: 5,
            status: RunStatus.Waiting);
        _loading = false;
    }
}
