{
  "schemaVersion": 1,
  "name": "Sample open url",
  "steps": [
    {
      "id": "open-example",
      "type": "OpenUrl",
      "url": "https://example.com"
    },
    {
      "id": "wait-for-heading",
      "type": "WaitFor",
      "selector": "h1"
    },
    {
      "id": "read-heading",
      "type": "ReadText",
      "selector": "h1",
      "output": "pageTitle"
    },
    {
      "id": "capture-page",
      "type": "Screenshot"
    }
  ]
}
